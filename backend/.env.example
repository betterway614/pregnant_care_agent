# AI-Care 后端环境变量示例
# 复制为 backend/.env 后填写真实密钥

# === 开发阶段（默认：全云模型）===
LLM_MODE=cloud
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-35b-a3b

# Agno 生产主路径
AGNO_ENABLED=true

# FGR 算法后端
# CUDA/现有 PyTorch 版本: FGR_BACKEND=cuda 或 pytorch
# AMD ROCm/iGPU 版本: FGR_BACKEND=rocm 或 onnx_igpu（ROCm 7.2 使用 MIGraphX provider）
# AMD NPU 版本: FGR_BACKEND=onnx_npu（VitisAI 不可用时自动回退 ROCm/CPU）
FGR_MODE=true
FGR_BACKEND=pytorch

# 角色专属（空则继承 LLM_MODE / LLM_MODEL）
# LLM_PREGNANT_MODE=cloud
# LLM_NURSE_MODE=cloud
# LLM_DOCTOR_MODE=cloud
# LLM_NURSE_MODEL=
# LLM_DOCTOR_MODEL=
# LLM_NURSE_TEMPERATURE=0.3
# LLM_DOCTOR_MAX_TOKENS=4096

# mixed 模式启用 cloud→local→mock 降级链
# LLM_MODE=mixed

# === 竞赛端侧部署完成后切换 ===
# LLM_MODE=local
# LLM_PREGNANT_MODE=local
# LLM_NURSE_MODE=local
# LLM_DOCTOR_MODE=local
# LOCAL_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434
# ASR_MODE=local
# ASR_PREGNANT_MODE=local
# RAG_ENABLED=true
# EMBEDDING_MODE=local
# DB_TYPE=postgres

# 数据库
DB_TYPE=sqlite
DB_NAME=ai_care

# RAG（开发可 mock）
RAG_ENABLED=false
EMBEDDING_MODE=mock
