# AI-Care 后端环境变量示例
# 复制为 backend/.env 后填写真实密钥

# === 开发阶段（默认：全云模型）===
LLM_MODE=cloud
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-35b-a3b

# Agno 生产主路径
AGNO_ENABLED=true

# FGR 算法后端
# pytorch: 默认旧路径，加载 .pth，torch.cuda 可用时自动走 GPU，否则走 CPU
# cuda: pytorch 的显式别名，用于保留现有 CUDA 部署写法
# rocm / onnx_igpu: ONNX Runtime + AMD MIGraphX/ROCm，加载 onnx_resnet/*.onnx
# onnx_npu: 优先 VitisAI/NPU；不可用时依次回退 ROCm/MIGraphX、ONNX CPU
# onnx_cpu: ONNX Runtime CPU 调试/回退
# mock: 请同时设置 FGR_MODE=false
FGR_MODE=true
FGR_BACKEND=pytorch

# 角色专属（空则继承 LLM_MODE / LLM_MODEL）
# LLM_PREGNANT_MODE=cloud
# LLM_NURSE_MODE=cloud
# LLM_DOCTOR_MODE=cloud
# LLM_NURSE_MODEL=
# LLM_DOCTOR_MODEL=
# LLM_NURSE_TEMPERATURE=0.3
# LLM_DOCTOR_MAX_TOKENS=4096

# mixed 模式启用 cloud→local→mock 降级链
# LLM_MODE=mixed

# === 竞赛端侧部署完成后切换 ===
# LLM_MODE=local
# LLM_PREGNANT_MODE=local
# LLM_NURSE_MODE=local
# LLM_DOCTOR_MODE=local
# LOCAL_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434
# ASR_MODE=local
# ASR_PREGNANT_MODE=local
# ASR_NURSE_MODE=local
# ASR_DOCTOR_MODE=local
# ASR_LOCAL_BACKEND=funasr
# ASR_LOCAL_BASE_URL=http://127.0.0.1:10096
# ASR_LOCAL_ENDPOINT=/v1/audio/transcriptions
# ASR_LOCAL_FUNASR_MODEL=local-funasr
# 如使用 FunASR 原生接口，也可设置：ASR_LOCAL_ENDPOINT=/recognition
# 如需回退 Whisper：ASR_LOCAL_BACKEND=whisper，ASR_LOCAL_MODEL=base
# RAG_ENABLED=true
# EMBEDDING_MODE=local
# DB_TYPE=postgres

# 数据库
DB_TYPE=sqlite
DB_NAME=ai_care

# RAG（开发可 mock）
RAG_ENABLED=false
EMBEDDING_MODE=mock
